# Copy this file to .env and fill in real values

PORT=5000

# PostgreSQL connection (must have the PostGIS extension available)
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_delivery_location
# Hosted (Neon/Supabase/Render) example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_delivery_location

# Set to "true" when connecting to a hosted DB that requires SSL (Neon, Supabase, Render)
DATABASE_SSL=false

# Base URL the server is reachable at (used to build absolute photo URLs)
SERVER_BASE_URL=http://localhost:5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
